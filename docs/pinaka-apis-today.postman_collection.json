                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/merchants/create-merchant",
            "description": "Use unique newMerchantId and initialStoreId. Creates merchant, store, and subscription.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"{{newMerchantId}}\",\n  \"businessName\": \"Test Retail\",\n  \"legalBusinessName\": \"Test Retail Pvt Ltd\",\n  \"businessType\": \"RETAIL\",\n  \"country\": \"India\",\n  \"state\": \"Telangana\",\n  \"city\": \"Hyderabad\",\n  \"postalCode\": \"500081\",\n  \"businessAddress\": \"Hitech City\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Owner\",\n  \"email\": \"owner@example.com\",\n  \"phone\": \"9876543210\",\n  \"billingContact\": true,\n  \"plan\": \"PRO\",\n  \"billingCycle\": \"Monthly\",\n  \"trialPeriod\": \"14\",\n  \"stores\": [\n    {\n      \"id\": \"{{initialStoreId}}\",\n      \"name\": \"Main Store\",\n      \"type\": \"RETAIL\",\n      \"url\": \"https://example.com\",\n      \"currency\": \"INR\",\n      \"status\": \"ACTIVE\",\n      \"address\": \"Hitech City\",\n      \"timezone\": \"Asia/Kolkata\",\n      \"city\": \"Hyderabad\",\n      \"state\": \"Telangana\",\n      \"zip\": \"500081\",\n      \"country\": \"India\"\n    }\n  ]\n}",
