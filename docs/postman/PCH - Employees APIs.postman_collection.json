{
  "info": {
    "_postman_id": "fa4b917c-66ad-4984-ac93-ddcd644a5c30",
    "name": "PCH - Employees APIs",
    "description": "Latest employee APIs. Employee CRUD returns employee details only (no store assignments). Use GET /merchants/:merchantId/employees to list one merchant. employeeCode, loginPin, and storeAssignments are optional and omitted from employee create/update.",
