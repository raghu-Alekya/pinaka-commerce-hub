  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Owner Login - Capture Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Owner authenticated', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const token = body.accessToken || body.access_token || body.token;",
                  "if (token) pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{authBaseUrl}}/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Employee Login by Username",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
