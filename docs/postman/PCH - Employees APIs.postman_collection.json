                "stores"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Roles Available for Selected Store Type",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Role catalog loaded', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const roles = (body.roles || []).filter(role => role.assignable);",
                  "if (roles[0]?.roleId) pm.collectionVariables.set('roleId', roles[0].roleId);",
                  "if (roles[1]?.roleId) pm.collectionVariables.set('secondRoleId', roles[1].roleId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/merchants/employees/stores/{{storeId}}/roles/available"
          },
          "response": []
        }
      ]
    },
