GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=OrderOut <no-reply@example.com>
MAIL_REPLY_TO=
RESEND_API_KEY=
DATABASE_URL=postgresql://pdh:pdh@localhost:5432/pdh
REDIS_URL=redis://localhost:6379
MESSAGE_BROKER_TYPE=kafka
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Connector platform API configuration (replace CONNECTOR with DOORDASH, SWIGGY,
# GRUBHUB, UBER_EATS, or ZOMATO).
# DOORDASH_API_BASE_URL=https://api.doordash.example
# DOORDASH_API_TOKEN=
# DOORDASH_API_KEY=
# HMAC secret used to authenticate incoming webhooks. Define one for every
# enabled connector: DOORDASH, SWIGGY, GRUBHUB, UBER_EATS, and ZOMATO.
# DOORDASH_WEBHOOK_SECRET=
# SWIGGY_WEBHOOK_SECRET=
# GRUBHUB_WEBHOOK_SECRET=
# UBER_EATS_WEBHOOK_SECRET=
# ZOMATO_WEBHOOK_SECRET=

