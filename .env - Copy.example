NODE_ENV=development
GATEWAY_PORT=3000
CONNECTOR_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
MERCHANT_SERVICE_PORT=3003
MENU_SERVICE_PORT=3004
INVENTORY_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3008
ADMIN_API_PORT=3009
AUTH_SERVICE_PORT=3010
MAIL_MODE=mock
# Use a long random value in production (for example, 32+ random bytes).
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_WEB_URL=http://localhost:3010
